# mcp-phish: environment configuration
# Copy this file to `.env` and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Mode toggle
# ---------------------------------------------------------------------------
# STUB_MODE=true  → returns realistic mock data, no network calls.
#                   Use this for development, demos, or while you wait on a
#                   phish.net API key.
# STUB_MODE=false → talks to api.phish.net v5 and phish.in v2. Requires
#                   PHISHNET_API_KEY (free at phish.net/api).
STUB_MODE=true

# ---------------------------------------------------------------------------
# Upstream API credentials (only required when STUB_MODE=false)
# ---------------------------------------------------------------------------
# Register at https://api.phish.net/keys/ (free).
PHISHNET_API_KEY=
# Phish.net public key (account identifier shown alongside the private API
# key). Phase 1 does not use it — included for Phase 2 (vault hydration)
# where authenticated-user endpoints come into play. Safe to leave blank.
PHISHNET_PUBLIC_KEY=
# Optional. phish.in is anonymous-friendly; an API key just raises rate caps.
PHISHIN_API_KEY=

# Override base URLs only for testing against a local mirror.
PHISHNET_BASE_URL=https://api.phish.net/v5
PHISHIN_BASE_URL=https://phish.in/api/v2

# ---------------------------------------------------------------------------
# Cache (aiosqlite)
# ---------------------------------------------------------------------------
# Container path. Mount a host volume here to persist the cache across
# restarts. The opaque KV cache stores raw JSON responses keyed by
# (endpoint, params_hash) — it is NOT a vault embryo. Phase 2 vault has its
# own normalized Postgres schema.
CACHE_DB_PATH=/data/phish-cache.db
CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Per-instance throttle (requests per second)
# ---------------------------------------------------------------------------
# Surface in the health() tool. Defaults are conservative; raise if you have
# a confirmed higher rate-limit allowance from the upstream operator.
THROTTLE_PHISHNET_RPS=5
THROTTLE_PHISHIN_RPS=10

# ---------------------------------------------------------------------------
# MCP server settings
# ---------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=3705

# Logging: structured JSON (production) or human-readable text (local dev).
LOG_LEVEL=INFO
LOG_FORMAT=json

TZ=UTC

# ---------------------------------------------------------------------------
# Phase 3: Vault read path (phish-vault Postgres)
# ---------------------------------------------------------------------------
# When VAULT_ENABLED=true, read tools serve answers from the phish-vault
# database instead of the live phish.net / phish.in APIs. Hot-window shows
# (newer than VAULT_HOT_WINDOW_HOURS) always read live, no matter what — the
# vault hydrates from the daily ETL so very recent shows lag the live feed.
# Health goes "degraded" when the last ETL run is older than
# VAULT_MAX_STALE_HOURS so callers can detect a stuck pipeline.
#
# When VAULT_ENABLED=false (default), the server behaves exactly like Phase 1
# — every call hits the live API path with the opaque cache in front.
VAULT_ENABLED=false
VAULT_HOT_WINDOW_HOURS=24
VAULT_MAX_STALE_HOURS=36

# Postgres connection. Defaults match the docker-compose network where
# mcp-phish joins the phish-vault stack and resolves `postgres` by name.
PG_HOST=postgres
PG_PORT=5432
PG_DB=phish
PG_USER=phish
# Required when VAULT_ENABLED=true. Use the same value as the phish-vault
# stack's PG_PASSWORD. Never commit a real password.
PG_PASSWORD=
