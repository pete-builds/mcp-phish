# Dummy environment for the release parity check. The SAME file is given to the
# last released image, the candidate and the parity client.
#
# Never put a real secret here: this file is committed. STUB_MODE=true makes
# every tool answer from built-in mock data with no network calls, so CI never
# reaches phish.net, phish.in or the vault database. MCP_HOST, MCP_PORT and
# MCP_TRANSPORT are deliberately not set: the check exists to catch a server
# whose own defaults stop answering other containers.
STUB_MODE=true
VAULT_ENABLED=false
PHISHNET_API_KEY=parity-dummy
